# Скопируйте этот файл в .env и заполните значения.
# НИКОГДА не коммитьте реальный .env с секретами в Git!

# Токен Telegram-бота (получить у @BotFather)
TG_BOT_TOKEN=your_bot_token_here

# Никнейм суперадминистратора (без символа @)
SUPER_ADMIN_USERNAME=YourTelegramUsername

# Директория для хранения базы данных (на сервере: /app/data)
DATA_DIR=/app/data
